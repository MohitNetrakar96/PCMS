# =============================================================
# PCMS Payment Gateway & Merchant API Configuration
# =============================================================

PORT=3000
JWT_SECRET=pcms_secret_token_123

# -------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY API KEYS (Optional for Live Mode)
# Obtain your Key ID and Key Secret from https://dashboard.razorpay.com/#/app/keys
# -------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# -------------------------------------------------------------
# 2. PHONEPE / CASHFREE MERCHANTS (Optional)
# -------------------------------------------------------------
PHONEPE_MERCHANT_ID=MERCHANT_ID_HERE
PHONEPE_SALT_KEY=SALT_KEY_HERE

CASHFREE_APP_ID=CASHFREE_APP_ID_HERE
CASHFREE_SECRET_KEY=CASHFREE_SECRET_KEY_HERE

# -------------------------------------------------------------
# 3. MERCHANT UPI VPA FOR DIRECT QR CODE PAYMENTS
# -------------------------------------------------------------
MERCHANT_UPI_VPA=pcmsbank@upi
